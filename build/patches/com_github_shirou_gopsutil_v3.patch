@@ -0,0 +1,30 @@
+//go:build linux && ppc64le
+// +build linux,ppc64le
+
+package host
+
+const (
+	sizeOfUtmp = 384
+)
+
+type utmp struct {
+	Type              int16
+	Pad_cgo_0         [2]byte
+	Pid               int32
+	Line              [32]byte
+	Id                [4]byte
+	User              [32]byte
+	Host              [256]byte
+	Exit              exit_status
+	Session           int32
+	Tv                timeval
+	Addr_v6           [4]int32
+}
+
+type exit_status struct {
+	Termination int16
+	Exit        int16
+}
+
+type timeval struct {
+	TvSec  int64
+	TvUsec int64
+}

