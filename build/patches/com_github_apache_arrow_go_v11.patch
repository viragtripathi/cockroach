+package utils
+
+// Generic implementations for ppc64le architecture
+// These are fallback implementations without SIMD optimizations
+
+func TransposeInt8Int8(src, dest []int8) {
+	for i := range src {
+		dest[i] = src[i]
+	}
+}
+
+func TransposeInt8Int16(src []int8, dest []int16) {
+	for i, v := range src {
+		dest[i] = int16(v)
+	}
+}
+
+func TransposeInt8Int32(src []int8, dest []int32) {
+	for i, v := range src {
+		dest[i] = int32(v)
+	}
+}
+
+func TransposeInt8Int64(src []int8, dest []int64) {
+	for i, v := range src {
+		dest[i] = int64(v)
+	}
+}
+
+func TransposeInt8Uint8(src []int8, dest []uint8) {
+	for i, v := range src {
+		dest[i] = uint8(v)
+	}
+}
+
+func TransposeInt8Uint16(src []int8, dest []uint16) {
